rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Match user specific subcollections or documents
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Match top-level expenses collection filtered by userId
    match /expenses/{expenseId} {
      allow read, write, create, update, delete: if request.auth != null && 
        (resource == null || resource.data.userId == request.auth.uid) && 
        (request.resource == null || request.resource.data.userId == request.auth.uid);
    }

    // Match top-level budgets collection filtered by userId
    match /budgets/{budgetId} {
      allow read, write, create, update, delete: if request.auth != null && 
        (resource == null || resource.data.userId == request.auth.uid) && 
        (request.resource == null || request.resource.data.userId == request.auth.uid);
    }

    // Match top-level categories collection filtered by userId or default
    match /categories/{categoryId} {
      allow read, write, create, update, delete: if request.auth != null && 
        (resource == null || resource.data.userId == request.auth.uid || resource.data.isDefault == true) && 
        (request.resource == null || request.resource.data.userId == request.auth.uid);
    }
  }
}
